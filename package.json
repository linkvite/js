{
	"name": "@linkvite/js",
	"version": "3.0.0",
	"description": "Official JavaScript/TypeScript SDK for Linkvite, generated from the Linkvite OpenAPI spec.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/linkvite/js.git"
	},
	"homepage": "https://docs.linkvite.io/sdks/javascript",
	"bugs": {
		"url": "https://github.com/linkvite/js/issues"
	},
	"author": "Linkvite <support@linkvite.io>",
	"license": "MIT",
	"keywords": [
		"linkvite",
		"bookmarks",
		"bookmark-manager",
		"sdk"
	],
	"packageManager": "pnpm@10.30.3",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"generate": "node scripts/generate.mjs",
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --typecheck",
		"check": "pnpm generate --check && pnpm lint && pnpm typecheck && pnpm test",
		"pre-release": "changeset",
		"release": "changeset version",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepare": "husky",
		"changeset": "changeset",
		"release:publish": "pnpm check && pnpm build && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.6.6",
		"husky": "^9.1.0",
		"openapi-typescript": "^7.8.0",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
